# Local development only. Choose a local database password before starting.
POSTGRES_PASSWORD=replace-with-a-local-development-password
# One exact browser origin, without a trailing slash, path, query or default port.
# HTTP development: localhost or 127.0.0.1 with COOKIE_SECURE=false.
# HTTPS deployment: e.g. https://cloudops.example.com with COOKIE_SECURE=true.
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_SECONDS=28800
# Explicit synthetic adapter; use none to publish honest missing-source outcomes.
# Neither mode contacts Kubernetes, Prometheus or a model. For the optional scoped
# Prometheus metric lab, set COLLECTION_SOURCE_MODE=prometheus and mount the read
# configuration described in docs/prometheus-metrics.md. The value may name more than
# one live provider (comma-separated); it may not be combined with development_fixture.
COLLECTION_SOURCE_MODE=development_fixture
# PROMETHEUS_READ_CONFIG=/run/cloudops-prometheus/read.json
# Live Kubernetes collection uses the read-only server/ca_data/token JSON.
# COLLECTION_SOURCE_MODE=live_kubernetes
# KUBE_READ_CONFIG=
# KUBE_CONFIGMAP_ENABLED=0
COLLECTOR_DELAY_SECONDS=2
COLLECTOR_FAIL=false
# Accepted automatic investigations that may wait for a dispatch slot (1-1000).
DEFERRED_RUN_LIMIT=100
# Job dispatch needs a trusted DispatchPermit/v1 outside PostgreSQL. Compose sets
# JOB_DISPATCH_ROOT for api/worker (read-only); issue it once with the dispatch-admin
# service. JOB_DISPATCH_ADMIN_UIDS (default 0) lists OS accounts allowed to administer it.
# See docs/job-dispatch.md.
# Alertmanager intake stays disabled unless the API has ALERT_INTAKE_CONFIG pointing to a
# mounted JSON file with the sender token digest; see docs/alert-intake.md and the lab overlay.
#
# E06 diagnosis profile (not read by any entrypoint in #68). A future #70 caller may load
# this trusted path; the JSON itself references the credential through an environment name.
# DIAGNOSIS_MODEL_CONFIG=config/diagnosis-model.json
