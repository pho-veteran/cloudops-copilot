# Local development only. Choose a local database password before starting.
POSTGRES_PASSWORD=replace-with-a-local-development-password
# One exact browser origin, without a trailing slash, path, query or default port.
# HTTP development: localhost or 127.0.0.1 with COOKIE_SECURE=false.
# HTTPS deployment: e.g. https://cloudops.example.com with COOKIE_SECURE=true.
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_SECONDS=28800
# Deterministic fixture collector; no Kubernetes or model credentials.
COLLECTOR_DELAY_SECONDS=2
COLLECTOR_FAIL=false
# Accepted automatic investigations that may wait for a dispatch slot (1-1000).
DEFERRED_RUN_LIMIT=100
# Alertmanager intake stays disabled unless the API has ALERT_INTAKE_CONFIG pointing to a
# mounted JSON file with the sender token digest; see docs/alert-intake.md and the lab overlay.
