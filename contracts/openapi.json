{
  "components": {
    "schemas": {
      "AdmissionView": {
        "properties": {
          "incident_id": {
            "format": "uuid",
            "title": "Incident Id",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "incident_id",
          "run_id"
        ],
        "title": "AdmissionView",
        "type": "object"
      },
      "AttemptView": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "expired",
              "succeeded",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "number",
          "state",
          "started_at",
          "finished_at",
          "error"
        ],
        "title": "AttemptView",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "EvidenceView": {
        "properties": {
          "collected_at": {
            "format": "date-time",
            "title": "Collected At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "payload": {
            "$ref": "#/components/schemas/FixturePayload"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          },
          "source": {
            "const": "development_fixture",
            "title": "Source",
            "type": "string"
          },
          "workload_uid": {
            "title": "Workload Uid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_id",
          "workload_uid",
          "source",
          "schema_version",
          "observed_at",
          "collected_at",
          "sha256",
          "payload"
        ],
        "title": "EvidenceView",
        "type": "object"
      },
      "FixturePayload": {
        "properties": {
          "label": {
            "const": "Synthetic development evidence; no live cluster was contacted.",
            "title": "Label",
            "type": "string"
          },
          "observation": {
            "const": "Live workload health and telemetry are unavailable.",
            "title": "Observation",
            "type": "string"
          },
          "workload": {
            "title": "Workload",
            "type": "string"
          }
        },
        "required": [
          "label",
          "workload",
          "observation"
        ],
        "title": "FixturePayload",
        "type": "object"
      },
      "HealthObservation": {
        "properties": {
          "component": {
            "enum": [
              "database",
              "worker",
              "collector",
              "diagnosis",
              "executor"
            ],
            "title": "Component",
            "type": "string"
          },
          "last_success_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "source": {
            "enum": [
              "runtime",
              "development_fixture",
              "unimplemented"
            ],
            "title": "Source",
            "type": "string"
          },
          "status": {
            "enum": [
              "available",
              "unavailable",
              "stale"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "component",
          "status",
          "observed_at",
          "last_success_at",
          "reason",
          "source"
        ],
        "title": "HealthObservation",
        "type": "object"
      },
      "HealthView": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/components/schemas/HealthObservation"
            },
            "title": "Observations",
            "type": "array"
          }
        },
        "required": [
          "observations"
        ],
        "title": "HealthView",
        "type": "object"
      },
      "IncidentDetail": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "state": {
            "const": "open",
            "title": "State",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "workload": {
            "$ref": "#/components/schemas/WorkloadView"
          },
          "workload_id": {
            "format": "uuid",
            "title": "Workload Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workload_id",
          "title",
          "description",
          "state",
          "created_by",
          "created_at",
          "workload"
        ],
        "title": "IncidentDetail",
        "type": "object"
      },
      "IncidentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/IncidentView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "required": [
          "items",
          "next_offset"
        ],
        "title": "IncidentPage",
        "type": "object"
      },
      "IncidentView": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "created_by": {
            "format": "uuid",
            "title": "Created By",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "state": {
            "const": "open",
            "title": "State",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "workload_id": {
            "format": "uuid",
            "title": "Workload Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workload_id",
          "title",
          "description",
          "state",
          "created_by",
          "created_at"
        ],
        "title": "IncidentView",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ManualIncidentRequest": {
        "properties": {
          "description": {
            "default": "",
            "maxLength": 4000,
            "title": "Description",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "workload_id": {
            "format": "uuid",
            "title": "Workload Id",
            "type": "string"
          }
        },
        "required": [
          "workload_id",
          "title"
        ],
        "title": "ManualIncidentRequest",
        "type": "object"
      },
      "Principal": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "operator"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "role"
        ],
        "title": "Principal",
        "type": "object"
      },
      "RunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "required": [
          "items",
          "next_offset"
        ],
        "title": "RunPage",
        "type": "object"
      },
      "RunView": {
        "properties": {
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttemptView"
            },
            "title": "Attempts",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "diagnosis": {
            "const": "unavailable",
            "default": "unavailable",
            "title": "Diagnosis",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceView"
            },
            "title": "Evidence",
            "type": "array"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "incident_id": {
            "format": "uuid",
            "title": "Incident Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "recovery": {
            "const": "unavailable",
            "default": "unavailable",
            "title": "Recovery",
            "type": "string"
          },
          "requested_by": {
            "format": "uuid",
            "title": "Requested By",
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "collecting",
              "insufficient_evidence",
              "failed"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "id",
          "incident_id",
          "state",
          "reason",
          "created_at",
          "finished_at",
          "requested_by",
          "evidence",
          "attempts"
        ],
        "title": "RunView",
        "type": "object"
      },
      "SessionView": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        },
        "required": [
          "principal",
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "WorkloadPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/WorkloadView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "required": [
          "items",
          "next_offset"
        ],
        "title": "WorkloadPage",
        "type": "object"
      },
      "WorkloadView": {
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "cluster": {
            "title": "Cluster",
            "type": "string"
          },
          "health": {
            "const": "unavailable",
            "default": "unavailable",
            "title": "Health",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "title": "Namespace",
            "type": "string"
          },
          "source": {
            "const": "development_fixture",
            "default": "development_fixture",
            "title": "Source",
            "type": "string"
          },
          "uid": {
            "title": "Uid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "cluster",
          "namespace",
          "name",
          "uid",
          "active"
        ],
        "title": "WorkloadView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "in": "cookie",
        "name": "cloudops_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "CloudOps Copilot",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthView"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Observations"
      }
    },
    "/api/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Liveness",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live"
      }
    },
